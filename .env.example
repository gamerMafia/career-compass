# --- AI (optional — without this the app uses smart rule-based matching) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database (optional — currently uses localStorage) ---
DATABASE_URL=postgresql://user:password@localhost:5432/career_compass

# --- Auth (optional — wire up Clerk when ready) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Tip jar (UPI) ---
# Your UPI ID — students see ₹49/99/199/499 + custom amount on the result page.
# On phones the amount opens directly in GPay/PhonePe/Paytm. No fees, no setup.
NEXT_PUBLIC_TIP_UPI_ID=yourname@oksbi
NEXT_PUBLIC_TIP_NAME=Career Compass
